# Supabase Configuration
# Replace these values with your actual project URL and anon public key from Supabase Dashboard -> Project Settings -> API.
# Note: NEVER expose your service_role key in frontend client applications!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# Application Defaults
VITE_APP_NAME=MyFinance
VITE_DEFAULT_CURRENCY=INR
VITE_DEFAULT_LOCALE=en-IN
VITE_DEFAULT_TIMEZONE=Asia/Kolkata
